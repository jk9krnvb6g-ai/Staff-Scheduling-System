rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; } // && request.auth.token.email_verified == true; (Using just null check since Google Auth auto verifies, but we can stick to standard if needed)
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isSuperAdmin() {
      return isSignedIn() && (request.auth.token.email == 'noy.thaweesit@gmail.com' || getUserData().role == 'superadmin');
    }
    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'noy.thaweesit@gmail.com' || getUserData().role in ['admin', 'superadmin']);
    }
    function isApprovedUser() {
      return isSignedIn() && (request.auth.token.email == 'noy.thaweesit@gmail.com' || getUserData().status == 'active');
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'status', 'workGroup', 'department', 'createdAt', 'updatedAt'])
        && data.email is string && data.email.size() > 0 && data.email.size() <= 100
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.role in ['superadmin', 'admin', 'user']
        && data.status in ['pending', 'active', 'rejected']
        && data.workGroup is string && data.workGroup.size() > 0 && data.workGroup.size() <= 100
        && data.department is string && data.department.size() > 0 && data.department.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['title', 'date', 'time', 'location', 'type', 'ownerId', 'workGroup', 'department', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.date is string && data.date.size() <= 20
        && data.time is string && data.time.size() <= 20
        && data.location is string && data.location.size() <= 200
        && data.type in ['urgent', 'medium', 'normal', 'info']
        && data.ownerId == request.auth.uid
        && data.workGroup is string && data.workGroup.size() > 0 && data.workGroup.size() <= 100
        && data.department is string && data.department.size() > 0 && data.department.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPresence(data) {
      return data.keys().hasAll(['isOnline', 'lastSeen', 'displayName', 'workGroup', 'department'])
        && data.isOnline is bool
        && data.lastSeen is timestamp
        && data.displayName is string && data.displayName.size() <= 100
        && data.workGroup is string && data.workGroup.size() > 0 && data.workGroup.size() <= 100
        && data.department is string && data.department.size() > 0 && data.department.size() <= 100;
    }

    function isValidHoliday(data) {
      return data.keys().hasAll(['date', 'name', 'description'])
        && data.date is string && data.date.size() > 0 && data.date.size() <= 20
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.description is string && data.description.size() <= 500;
    }

    // Rules
    match /users/{userId} {
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid
        && isValidUser(incoming())
        && incoming().keys().size() == 8
        && incoming().email == request.auth.token.email
        && (incoming().role == 'user' || request.auth.token.email == 'noy.thaweesit@gmail.com')
        && (incoming().status == 'pending' || request.auth.token.email == 'noy.thaweesit@gmail.com')
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().email == existing().email
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'role', 'updatedAt', 'workGroup', 'department']))
          ||
          (userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );

      allow get: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isAdmin() || (isApprovedUser() && existing().workGroup == getUserData().workGroup && existing().department == getUserData().department));
      allow list: if isSignedIn() && (isAdmin() || (isApprovedUser() && existing().workGroup == getUserData().workGroup && existing().department == getUserData().department));
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow create: if isApprovedUser() && isValidId(eventId) && isValidEvent(incoming())
        && incoming().keys().size() == 10
        && incoming().ownerId == request.auth.uid
        && incoming().workGroup == getUserData().workGroup
        && incoming().department == getUserData().department
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isApprovedUser() && isValidId(eventId) && isValidEvent(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().ownerId == existing().ownerId
        && incoming().workGroup == existing().workGroup
        && incoming().department == existing().department
        && incoming().updatedAt == request.time
        && (
           incoming().ownerId == request.auth.uid || isAdmin()
        )
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'date', 'time', 'location', 'type', 'updatedAt']);

      allow delete: if isApprovedUser() && isValidId(eventId) && (existing().ownerId == request.auth.uid || isAdmin());

      allow get: if isApprovedUser() && isValidId(eventId) && (isAdmin() || (existing().workGroup == getUserData().workGroup && existing().department == getUserData().department));
      allow list: if isApprovedUser() && (isAdmin() || (existing().workGroup == getUserData().workGroup && existing().department == getUserData().department));
    }

    match /presence/{userId} {
      allow create: if isApprovedUser() && isValidId(userId) && userId == request.auth.uid
        && isValidPresence(incoming())
        && incoming().keys().size() == 5
        && incoming().workGroup == getUserData().workGroup
        && incoming().department == getUserData().department;

      allow update: if isApprovedUser() && isValidId(userId) && userId == request.auth.uid
        && isValidPresence(incoming())
        && incoming().workGroup == existing().workGroup
        && incoming().department == existing().department
        && incoming().diff(existing()).affectedKeys().hasOnly(['isOnline', 'lastSeen', 'displayName']);

      allow get: if isApprovedUser() && isValidId(userId) && (isAdmin() || (existing().workGroup == getUserData().workGroup && existing().department == getUserData().department));
      allow list: if isApprovedUser() && (isAdmin() || (existing().workGroup == getUserData().workGroup && existing().department == getUserData().department));
    }

    match /holidays/{holidayId} {
      allow create: if isAdmin() && isValidId(holidayId) && isValidHoliday(incoming()) && incoming().keys().size() == 3;
      allow update: if isAdmin() && isValidId(holidayId) && isValidHoliday(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'name', 'description']);
      allow delete: if isAdmin() && isValidId(holidayId);
      allow get: if isApprovedUser() && isValidId(holidayId);
      allow list: if isApprovedUser();
    }
  }
}
